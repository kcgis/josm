<?xml version="1.1" encoding="UTF-8"?>
<presets
  xmlns="http://josm.openstreetmap.de/tagging-preset-1.0"
  author="Josh Carlson"
  version="2.0"
  description="Preset for digitizing parcels, lots, subs and more"
  shortdescription="Cadastre Presets"
>

<!-- reusable chunks for cadastral lifecycle -->

  <chunk id="lifecycle">
    <text key="start_date" text="Date created" />
    <text key="start_date:source" text="Document number" />
    <text key="end_date" text="Date retired" />
    <text key="end_date:source" text="Document number" />
  </chunk>

  <group name="Cadastre">

    <item name="Lifecycle Information" type="node,way,closedway,multipolygon"
      icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/calendar.svg">
      <reference ref="lifecycle" />
    </item>

    <group name="Boundaries"
      icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/boundary.svg">

      <item name="PLSS" type="way"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/aliquot.svg">
        <key key="line" value="plss" />
        <combo key="plss" text="PLSS Line Type" values="township,section,quarter-section,indian_boundary_line" values_sort="false" match="keyvalue!" />
      </item>

      <item name="PLSS Corner" type="node"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/plss.svg">
        <key key="cadastre" value="point" />
        <key key="point" value="plss" />
        <text key="x" text="X Coordinate (Eastings)" />
        <text key="y" text="Y Coordinate (Northings)" />
        <check key="position" value_on="fixed" text="Fixed Position?" disable_off="true" />
        <text key="note" text="Document Number" />
      </item>

      <item name="Survey Marker" type="node"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/marker.svg">
        <key key="cadastre" value="point" />
        <key key="point" value="marker" />
        <text key="x" text="X Coordinate (Eastings)" />
        <text key="y" text="Y Coordinate (Northings)" />
        <check key="position" value_on="fixed" text="Fixed Position?" disable_off="true" />
        <preset_link preset_name="Lifecycle Information" />
      </item>

      <item name="Parcel Corner" type="node"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/boundary.svg">
        <key key="cadastre" value="point" />
        <key key="point" value="marker" />
        <text key="x" text="X Coordinate (Eastings)" />
        <text key="y" text="Y Coordinate (Northings)" />
        <check key="position" value_on="fixed" text="Fixed Position?" disable_off="true" />
      </item>
    </group>

    <group name="New Areas" icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/plus.svg">

      <item name="Parcel" type="closedway,multipolygon" name_template="Parcel {name}"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/P.svg">
        <key key="cadastre" value="parcel" />
        <text key="name" text="PIN" use_last_as_default="true" />
        <label text="Or other identifier" />
        <space />
        <label text="Document / Dates" />
        <text key="start_date" text="Document date" use_last_as_default="true" />
        <text key="start_date:source" text="Document number" use_last_as_default="true" />
        <text key="start_date:devnet" text="DevNet Date" use_last_as_default="true" />
      </item>

      <item name="Parcel (Pending)" type="closedway,multipolygon" name_template="Pending parcel for {start_date:source}"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/pending.svg">
        <key key="cadastre" value="pending_parcel" />
        <space />
        <text key="start_date" text="Document date" />
        <text key="start_date:source" text="Document number" />
        <space />
        <text key="note" text="Notes" />
      </item>

      <item name="Parcel (Overlapping Type)" type="closedway,multipolygon" name_template="Overlapping Parcel {name}"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/P-stack.svg">
        <key key="cadastre" value="parcel" />
        <text key="name" text="PIN" />
        <space />
        <combo key="parcel" text="Type" values="leasehold,pollution_control,condo_unit" match="keyvalue!"/>
        <space />
        <label text="Document / Dates" />
        <text key="start_date" text="Document date" use_last_as_default="true" />
        <text key="start_date:source" text="Document number" use_last_as_default="true" />
        <text key="start_date:devnet" text="DevNet Date" use_last_as_default="true" />
      </item>

      <item name="Lot" type="closedway,multipolygon" name_template="Lot {name}"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/L.svg">
        <key key="cadastre" value="lot" />
        <text key="name" text="Lot number or name" use_last_as_default="true" />
        <label text="Document / Dates" />
        <text key="start_date" text="Document date" use_last_as_default="true" />
        <text key="start_date:source" text="Document number" use_last_as_default="true" />
      </item>

      <item name="Subdivision" type="closedway,multipolygon"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/S.svg">
        <key key="cadastre" value="subdivision" />
        <text key="name" text="Subdivision name" />
        <label text="Document / Dates" />
        <text key="start_date" text="Document date" />
        <text key="start_date:source" text="Document number" />
        <text key="slot" text="Slot number(s)" />
        <label text="Use hyphen for a range, e.g., '2102-2106'" />
      </item>

      <item name="Right-of-Way" type="closedway,multipolygon" name_template="ROW ({jurisdiction})"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/R.svg">
        <key key="cadastre" value="right-of-way" />
        <combo key="jurisdiction" text="Jurisdiction" values_sort="false" values="Illinois,Kendall County,Plano,Yorkville,Oswego,Montgomery,Aurora,Millbrook,Millington,Newark,Lisbon,Plattville,Plainfield,Joliet,Shorewood,Minooka,Little Rock Township,Bristol Township,Oswego Township,Fox Township,Kendall Township,Na-Au-Say Township,Big Grove Township,Lisbon Township,Seward Township" />
        <label text="Document / Dates" />
        <text key="start_date" text="Document date" />
        <text key="start_date:source" text="Document number" />
      </item>

    </group>

    <group name="Retired" icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/minus.svg">

      <item name="Retired Parcel" type="closedway,multipolygon" name_template="Retired Parcel {name}"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/P-slash.svg">
        <key key="cadastre" value="parcel" />
        <label text="Retired Document / Dates" />
        <text key="end_date" text="Document date" match="key!" use_last_as_default="true" />
        <text key="end_date:source" text="Document number" use_last_as_default="true" />
        <text key="end_date:devnet" text="DevNet date" use_last_as_default="true" />
      </item>

      <item name="Retired Lot" type="closedway,multipolygon" name_template="Retired Lot {name}"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/L-slash.svg">
        <key key="cadastre" value="lot" />
        <label text="Retired Document / Dates" />
        <text key="end_date" text="Document date" match="key!" />
        <text key="end_date:source" text="Document number" />
      </item>

      <item name="Retired Subdivision" type="closedway,multipolygon"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/S-slash.svg">
        <key key="cadastre" value="subdivision" />
        <label text="Retired Document / Dates" />
        <text key="end_date" text="Document date" match="key!" />
        <text key="end_date:source" text="Document number" />
      </item>

      <item name="Retired Right-of-Way" type="closedway,multipolygon" name_template="Retired ROW ({jurisdiction})"
        icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/R-slash.svg">
        <key key="cadastre" value="right-of-way" />
        <label text="Retired Document / Dates" />
        <text key="end_date" text="Document date" match="key!" />
        <text key="end_date:source" text="Document number" />
      </item>

    </group>

  </group>

  <group name="Taxing Bodies" icon="https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/cash.svg">

    <item name="Drainage District" type="closedway,multipolygon">
      <key key="taxing_body" value="drainage" />
      <text key="name" text="Name" />
      <text key="start_date:source:name" text="Ordinance Number" />
      <label text="Include name, e.g., 'Joliet Ordinance 1234'" />
      <reference ref="lifecycle" />
    </item>

    <item name="Park District" type="closedway,multipolygon">
      <key key="taxing_body" value="park" />
      <text key="name" text="Name" />
      <text key="start_date:source:name" text="Ordinance Number" />
      <label text="Include name, e.g., 'Joliet Ordinance 1234'" />
      <reference ref="lifecycle" />
    </item>

    <item name="Sanitary District" type="closedway,multipolygon">
      <key key="taxing_body" value="sanitary" />
      <text key="name" text="Name" />
      <text key="start_date:source:name" text="Ordinance Number" />
      <label text="Include name, e.g., 'Joliet Ordinance 1234'" />
      <reference ref="lifecycle" />
    </item>

    <item name="Library District" type="closedway,multipolygon">
      <key key="taxing_body" value="drainage" />
      <text key="name" text="Name" />
      <text key="start_date:source:name" text="Ordinance Number" />
      <label text="Include name, e.g., 'Joliet Ordinance 1234'" />
      <reference ref="lifecycle" />
    </item>

    <item name="Municipality" type="closedway,multipolygon">
      <key key="taxing_body" value="municipality" />
      <text key="name" text="Name" />
      <text key="start_date:source:name" text="Ordinance Number" />
      <label text="Include name, e.g., 'Joliet Ordinance 1234'" />
      <reference ref="lifecycle" />
    </item>

    <item name="Special Service Area" type="closedway,multipolygon">
      <key key="taxing_body" value="special_service_area" />
      <text key="name" text="Name" />
      <text key="start_date:source:name" text="Ordinance Number" />
      <label text="Include name, e.g., 'Joliet Ordinance 1234'" />
      <reference ref="lifecycle" />
    </item>

    <item name="Tax Increment Financing" type="closedway,multipolygon">
      <key key="taxing_body" value="tax_increment_financing" />
      <text key="name" text="Name" />
      <text key="start_date:source:name" text="Ordinance Number" />
      <label text="Include name, e.g., 'Joliet Ordinance 1234'" />
      <reference ref="lifecycle" />
    </item>

  </group>

</presets>
