/* {0} on a node, should be a way */
node[cadastre],
node[taxing_body] {
  throwWarning: tr("{0} tag on a node. Should be used on a way.", "{0.key}");
}

/* Parcel overlapping parcel when both active (spatial test) */
area[cadastre=parcel][!parcel][!end_date] ⧉ area[cadastre=parcel][!parcel][!end_date] {
  throwWarning: tr("Overlapping active standard parcels. Should something have a leasehold / condo tag? Or is one missing an end date?");
}

way!:closed[cadastre] {
  throwWarning: tr("Cadastre area not closed.");
}

node[position=fixed]:modified node[position=fixed]!:new {
  throwError: "Fixed node has been modified! Don't move these!";
}