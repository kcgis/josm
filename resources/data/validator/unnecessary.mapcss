*[length],
*[stated_area],
*[globalid],
*[distance],
*[planname],
*[cadastre][start_date:devnet][cadastre!=parcel] {
  /* see #9365 - Useless tag layer=0 */
  throwWarning: tr("{0} is unnecessary", "{0.tag}");
  group: tr("unnecessary tag");
  fixRemove: "{0.key}";
  assertMatch: "way length=*";
  assertMatch: "way stated_area=*";
}
