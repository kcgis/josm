meta {
    title: "Kendall County Cadastre Styles";
    description: "Helping symbolize and label features from the Kendall County Cadastre in a way that makes sense there";
    version: "2.0";
    author: "Josh Carlson";
}

/* settings */
settings::colors
{
    label: "Colors";
}

setting::background
{
    type: color;
    label: "Background color";
    default: #aaaaaaff;
    group: "colors";
}

setting::color_parcel
{
    type: color;
    label: "Parcel color";
    default: #ffff79ff;
    group: "colors";
}

setting::color_lot
{
    type: color;
    label: "Lot color";
    default: #08affcff;
    group: "colors";
}

setting::color_row
{
    type: color;
    label: "ROW color";
    default: #9900ffff;
    group: "colors";
}

setting::color_sub
{
    type: color;
    label: "Subdivision color";
    default: #00ff08ff;
    group: "colors";
}

setting::label_areas
{
    type: boolean;
    label: "Show area labels";
    default: true;
}

setting::retired_fill
{
    type: boolean;
    label: "Render retired features with hashed lines";
    default: true;
}

canvas
{
    fill-color: setting("background");
    default-points: false;
    default-lines: false;
}

way!:tagged
{
    color: #ff97ff;
    width: 2;
}

way:tagged, relation > way
{
    width: 1;
    color: #888888;
}

way:selected::selection
{
    width: 3;
    color: #ff0000;
}

/* global node defaults */
node|z16-
{
    symbol-shape: circle;
    symbol-stroke-color: #00000000;
    symbol-size: 3;
}

node|z17-18
{
    symbol-size: 5;
    symbol-stroke-color: black;
}

node|z19-
{
    symbol-size: 6;
    symbol-stroke-color: black;
}

/* vertex on a retired parcel */
way[end_date] > node
{
    symbol-fill-color: #88000088;
}

/* default node rendering */
way[!end_date] > node
{
    symbol-fill-color: black;
}

way[!end_date] > node|z17-
{
    symbol-fill-color: #ffffff88;
    z-index: 200;
}

/* kill labels unless asked for */
*
{
    font-size: 0;
}

/* cadastral areas */
/* label areas on zoom */
area[cadastre][setting("label_areas")]
{
    text-halo-color: #000000cc;
    text-halo-radius: 2;
    font-size: 14;
    text: name;
    text-position: center;
}

area[cadastre=parcel]
{
    fill-color: setting("color_parcel");
    text-color: setting("color_parcel");
}

area[cadastre=parcel], area[cadastre=parcel] > way
{
    width: 2;
    z-index: 10;
    color: setting("color_parcel");
}

/* parcel types */
area[parcel_type=condo_unit]
{
    fill-opacity: 0.1;
}

/* abbreviate PIN at high zoom */
area|z-18[cadastre=parcel]
{
    text: substring(tag("name"), length(tag("name")) - 3);
}

area[cadastre=lot]
{
    fill-color: setting("color_lot");
    text-color: setting("color_lot");
    fill-extent: 20;
}

area[cadastre=lot], area[cadastre=lot] > way
{
    width: 2;
    z-index: 5;
    text-offset: -20;
    offset: -1.5;
    color: setting("color_lot");
}

area[cadastre=subdivision]
{
    fill-color: setting("color_sub");
    text-color: setting("color_sub");
    fill-extent: 30;
}

area[cadastre=subdivision], area[cadastre=subdivision] > way
{
    width: 4;
    z-index: 0;
    text-position: line;
    text-offset: 12;
    offset: 3;
    color: setting("color_sub");
}

area[cadastre=right-of-way]
{
    fill-color: setting("color_row");
    text-color: setting("color_row");
    fill-extent: 20;
}

area[cadastre=right-of-way], area[cadastre=right-of-way] > way
{
    width: 2;
    offset: -1.5;
    z-index: 6;
    text: operator;
    color: setting("color_row");
}

area|z-17[cadastre]
{
    font-size: 0;
    width: 1;
}

/* alter label and area boundary for retired features */
*[end_date]
{
    text-color: #cc0000;
    font-style: italic;
    color: #690000;
    width: 2;
    z-index: -1;
}

/* fade retired features if hashed lines setting is off */
area[end_date][!setting("retired_fill")]
{
    opacity: 0.25;
}

/* hashed fill for retired cadastre */
area[end_date][cadastre=parcel][setting("retired_fill")]
{
    fill-image: "https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/parcel-hash.svg";
    fill-extent: 20;
}

area[end_date][cadastre=lot][setting("retired_fill")]
{
    fill-image: "https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/lot-hash.svg";
}

area[end_date][cadastre=subdivision][setting("retired_fill")]
{
    fill-image: "https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/sub-hash.svg";
}

area[end_date][cadastre=right-of-way][setting("retired_fill")]
{
    fill-image: "https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/row-hash.svg";
}

/* taxing bodies */
area[taxing_body][setting("label_areas")]
{
    text-halo-color: #ffffffcc;
    text-color: #333333ff;
    text-halo-radius: 1;
    font-size: 11;
    text: name;
    text-position: center;
}

area[taxing_body]
{
    fill-color: hsb_color(CRC32_checksum(tag("name"))/4294967296.0, 0.2, 0.9);
    fill-extent: 40;
    fill-opacity: 0.3;
    width: 3;
    dashes: 8;
}

/* PLSS lines */

way[line=plss]
{
    color: cadastre_plss#ffffff;
    z-index: 75;
}

way[plss=quarter-section]
{
    width: 1;
    dashes: 2,6;
}

way[plss=section]
{
    width: 2;
    dashes: 4,8;
}

way[plss=township]
{
    width: 4;
    dashes: 6,10;
}

way[plss=indian_boundary_line]
{
    width: 4;
    dashes: 15, 15, 5, 15;
    color: #ff7b00;
}

/* other special nodes */
node[point=plss]
{
    icon-image: "https://codeberg.org/kendall-county-gis/maramech-josm-files/raw/branch/main/styles/icons/plss.svg";
    icon-height: 15;
}

node|z18-[point=plss]
{
    icon-height: +15;
}

node[point=marker]
{
    symbol-shape: pentagon;
    symbol-size: +4;
}

node[point=parcel_corner]
{
    symbol-stroke-width: 3;
    symbol-size: +1;
}

/* fixed points */
node[position=fixed]::fixed
{
    symbol-size: 30;
    symbol-shape: circle;
    symbol-fill-color: #00eeee22;
    z-index: 60;
}

/* pending parcels */
area[cadastre=pending_parcel]
{
    fill-extent: 30;
    fill-color: #ffdd99;
    text: tag("start_date:source");
    font-style: italic;
    text-color: #ffdd44;
    width: 2;
    dashes: 4;
}

/* PLSS */
area[cadastre=plss]
{
    fill-color: #dddddd44;
    text: tag("ref");
    text-position: center;
    font-size: 20;
    fill-extent: 10;
}

/* LDR features */
area[globalid]
{
    fill-color: white;
}

area[globalid] > node
{
    symbol-size: 2px;
    symbol-color: white;
    symbol-stroke-color: white;
    z-index: 90;
}

way[distance]
{
    color: white;
    dashes: 4;
    width: 2;
    text: round(tag("distance") * 100) / 100;
    font-size: 14;
    text-halo-color: black;
    text-halo-radius: 3;
    text-position: line;
}

way[distance][radius]::sketchradius
{
    text: concat("R = ", round(tag("radius") * 100) / 100);
    font-size: 14;
    text-halo-color: black;
    text-halo-radius: 3;
    text-offset: 20;
    text-position: line;
}

way[distance] >[index=-1] node, way[distance] >[index=1] node
{
    symbol-size: 10;
    z-index: 100;
    symbol-stroke-color: white;
}

/* flag errors */

*[cadastre][distance]::badline
{
    width:18;
    color: #e2272766;
    z-index: -1;
    text: You left some LDR tags on here!;
    text-position: line;
    font-size: 12;
    text-color: black;
    text-halo-radius: 3;
    text-offset: -20;
}

node[!cadastre]:tagged, node[cadastre!=point]:tagged
{
    symbol-fill-color: #ff8800ff;
    symbol-stroke-color: #ff0000ff;
    symbol-stroke-width: 2;
    symbol-size: 20;
    symbol-shape: triangle;
}

/* fixme */
*[fixme]::fixme
{
    width: 20;
    color: #ffff0044;
}
